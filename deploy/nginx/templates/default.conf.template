# XKX 反向代理（TLS 终止）。本文件是 envsubst 模板，
# 由官方 nginx 镜像启动时渲染到 /etc/nginx/conf.d/default.conf。
# 文件名必须是 default.conf.template：渲染目标正好覆盖镜像自带的默认站点，
# 否则默认站点会继续抢占 80 端口（Host 不匹配时落到它的 404），
# 表现为探活/跳转"配置写了却不生效"。
#
# 渲染变量（只替换容器环境里真实存在的变量，$host/$scheme 等 nginx 变量不受影响）：
#   ADMIN_ENABLED  1=开放管理路径；0=整个 /admin/ 与 /api/admin/ 返回 404（公网屏蔽开关）
#
# 选 nginx 而不是 caddy 的原因：
#   1) 需要把请求体上限严格对齐后端（8KB）并单独放行探活路径，nginx 的
#      client_max_body_size / location 语义最直接；
#   2) 证书可来自自有 CA/运维统一签发，不必依赖 ACME 域名校验；
#   3) 生产常见、排障资料多，配置可被 nginx -t 静态校验。
#
# 安全边界：
#   - 只在 proxy 上监听 80/443；world 的 8020/8030 与 admin 的 8031 不发布到公网。
#   - 80 只做 301 到 HTTPS；唯一例外是 ACME HTTP-01 校验路径。
#   - 证书/私钥从宿主 deploy/certs/ 只读挂载，不入库、不进镜像。
#   - 管理面与玩家入口路径分离：/admin/ 与 /api/admin/ 是独立前缀，玩家路径不动。
#   - 管理面默认要求 HTTP Basic（第二层才是控制台自己的 XKX_ADMIN_TOKEN 登录）。

server {
    listen 80;
    listen [::]:80;
    server_name _;

    # 唯一的明文例外：ACME HTTP-01。certbot --webroot 写到宿主 deploy/certs/acme/，
    # 容器内只读挂到 /var/www/certbot。续期时不需要临时改跳转配置。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
        access_log off;
    }

    # 其余一律 301 到 HTTPS。用 301（永久）而不是 308：这里没有任何需要保留
    # POST body 的明文端点，永久跳转可被客户端缓存，减少一次往返。
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/xkx.crt;
    ssl_certificate_key /etc/nginx/certs/xkx.key;

    # 只允许 TLS 1.2/1.3；1.0/1.1 已被 RFC 8996 废弃。
    ssl_protocols       TLSv1.2 TLSv1.3;
    # Mozilla intermediate 套件：仅 AEAD（GCM/CHACHA20），无 RSA 密钥交换、无 CBC。
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;

    # HSTS 先给 300 秒（5 分钟）：只覆盖"确认 https 可用"阶段，回滚代价极小。
    # 调长条件见 docs/OPS-RUNBOOK.md §1.4：连续一周无 https 故障、无混合内容，
    # 再改成 max-age=31536000；includeSubDomains 需先确认所有子域都支持 https；
    # preload 需额外做子域清单审计，且一旦 preload 无法快速撤销。
    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    # 管理面公网开关：由 compose 的 XKX_ADMIN_PUBLIC 渲染。
    set $admin_enabled "${ADMIN_ENABLED}";

    # ---- 上游解析（冷启动正确性）
    # 静态 `proxy_pass http://admin:8031` 只在 nginx 启动时解析一次。冷启动时
    # admin 容器可能还没在 Docker DNS 注册，nginx 会把解析结果（实测可能是一个
    # 错误地址，如 198.18.3.188:8031）缓存下来，之后 admin 已经 healthy 也仍然
    # 持续 502，只能 docker restart proxy 才恢复。
    # 改成"变量式 proxy_pass + Docker 内置 DNS resolver"：每次请求按当前 DNS
    # 记录解析，valid=10s 让容器重建/IP 变化后最多 10 秒自动跟上。
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;
    set $world_api  world:8020;
    set $world_ui   world:8030;
    set $admin_api  admin:8031;

    # 与后端 src/wsim/api/server.py 的 _MAX_BODY_BYTES（8*1024）一致。
    # 后端超限返回 JSON 413 payload_too_large；nginx 在更早一层也会以 413 拒绝，
    # 两者阈值相同，避免"反代放行、后端拒绝"或反之的错位。
    client_max_body_size 8k;
    client_body_buffer_size 8k;
    client_body_timeout 30s;
    client_header_timeout 15s;

    # 后端读超时与 XKX_REQUEST_TIMEOUT（默认 30s）对齐。
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    proxy_connect_timeout 10s;

    # 转发头：
    #   - X-Forwarded-For 直接写 $remote_addr（edge 观察到的真实来源），不用
    #     $proxy_add_x_forwarded_for —— 后者会把客户端自带的 XFF 原样拼在最前面，
    #     可被伪造。下游若按 XFF 取最右值，拿到的就是真实来源。
    #   - 后端目前只按 TCP 对端限流（src/wsim/api/server.py::_client_ip 明确不读 XFF），
    #     反代后它看到的对端是 proxy 的内网地址，限流粒度为整站而非单客户端；
    #     管理台白名单同理，放行的是 proxy 固定 IP。详见 OPS-RUNBOOK §1.4。
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_http_version 1.1;
    proxy_set_header Connection        "";

    # proxy 自身探活（https；80 已不提供明文探活）
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        # location 里的 add_header 会覆盖 server 级，安全头必须重复声明。
        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        return 200 "ok\n";
    }

    # 后端真实探活：单独放行、不记访问日志（高频探活不污染日志）
    location = /api/health {
        access_log off;
        proxy_pass http://$world_api;
    }

    # ---------------------------------------------------------------- 管理面
    # 独立前缀，不与玩家入口混用。两层校验按端点分工：
    #   - /admin/ 与 /api/admin/login：反代 HTTP Basic（浏览器缓存的 Basic 凭据
    #     会随同源请求自动带上）；
    #   - 其余 /api/admin/*：由控制台自己的 Bearer 会话令牌守护（后端 require_auth）。
    # 为什么不对全部 /api/admin/ 加 Basic：控制台前端调用 API 时发
    # `Authorization: Bearer <session>`，同一个头会覆盖 Basic，导致每次请求 401；
    # 因此 Basic 只放在不带 Bearer 的页面与登录端点上，避免"两层认证互相顶掉"。
    # 公网屏蔽开关：XKX_ADMIN_PUBLIC=0 时返回 404，不暴露该路径是否存在。
    location = /admin {
        if ($admin_enabled = "0") { return 404; }
        return 301 https://$host/admin/;
    }

    location /admin/ {
        if ($admin_enabled = "0") { return 404; }
        auth_basic "XKX Admin";
        auth_basic_user_file /etc/nginx/certs/admin.htpasswd;
        alias /usr/share/nginx/admin/;
        index index.html;
        # 本 location 有 add_header，server 级安全头不再继承，必须重复。
        add_header Strict-Transport-Security "max-age=300" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
    }

    location = /api/admin/login {
        if ($admin_enabled = "0") { return 404; }
        auth_basic "XKX Admin";
        auth_basic_user_file /etc/nginx/certs/admin.htpasswd;
        proxy_pass http://$admin_api;
    }

    location /api/admin/ {
        if ($admin_enabled = "0") { return 404; }
        # 不在这里加 auth_basic：见上，Bearer 会覆盖 Basic。
        proxy_pass http://$admin_api;
    }

    # ---------------------------------------------------------------- 玩家面
    # API（引擎/鉴权/状态/动作）
    location /api/ {
        proxy_pass http://$world_api;
    }

    # 玩家前端（8030 的静态页与同源代理）
    location / {
        proxy_pass http://$world_ui;
    }
}
