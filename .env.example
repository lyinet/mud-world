# world-sim 模型配置示例
#
# 用法:
#   cp .env.example .env
#   编辑 .env 填入你的 key
#   set -a; . ./.env; set +a
#   .venv/bin/python sim/run_headless.py --days 10 --seed 42 --npc 0 --enable-llm
#
# 注意:
#   - 只有显式加 --enable-llm 才会联网；默认离线运行，不需要任何 key。
#   - 本文件只放环境变量占位符，不要把真实 key 写进这个文件或任何会被 git 跟踪的文件。
#   - 免费档延迟约 10 秒，建议只用于夜间批处理。

# OpenAI 兼容中转站地址（末尾可带 /v1）。换成你自己的网关地址。
LLM_BASE_URL=http://127.0.0.1:3425/v1

# API key。这里写占位符，真实值放在 .env 或 shell 环境里，不要提交。
LLM_API_KEY=sk-your-key-here

# 两个模型槽位未单独指定时的兜底模型名。
LLM_MODEL=group/all

# 决策槽：夜间批处理、目标选择、replan。建议用便宜/稳定的模型。
LLM_DECISION_MODEL=group/all

# 对话槽：玩家在场对话、聚光档 NPC 发言。建议用文风更好的模型。
LLM_DIALOGUE_MODEL=group/all

# 可选：意图槽（config/llm.yaml 里 type=xing_intent 时使用）。
# 如果只想用普通 OpenAI 兼容模型，把 config/llm.yaml 的 intent.type 改成 openai_chat 即可。
# XING_API_KEY=sk-your-xing-key-here
# XING_INTENT_MODEL=openrouter/xingchen-agi/xing4.0-29b-a4b:free
