  "authored_descriptions": [
    {
      "desc": "一件洗得发白的粗布衣裳，针脚细密，是寻常人家最常穿的衣物。",
      "id": "/d/hangzhou/npc/obj/cloth",
      "table": "items"
    },
    {
      "desc": "一块硝制过的狗皮，皮毛粗糙却厚实，披在身上倒也挡风。",
      "id": "/d/hangzhou/npc/obj/goupi",
      "table": "items"
    },
    {
      "desc": "一本描金的婚约，写着你与结发之人的名字，须得去红娘庄才能解除。",
      "id": "/d/hangzhou/npc/obj/marry_card",
      "table": "items"
    },
    {
      "desc": "一双绣着并蒂莲的软底小鞋，针线精巧，鞋面还带着淡淡的脂粉香。",
      "id": "/d/jiaxing/npc/flower_shoe",
      "table": "items"
    },
    {
      "desc": "一件半旧的粗布短衣，浆洗得干净，是嘉兴一带百姓的常服。",
      "id": "/d/jiaxing/npc/obj/cloth",
      "table": "items"
    },
    {
      "desc": "一件素色布衣，布料虽粗，却缝补得整整齐齐。",
      "id": "/d/jiaxing/obj/cloth",
      "table": "items"
    },
    {
      "desc": "一双大红缎面的绣花小鞋，鞋尖缀着绒球，走起路来悄无声息。",
      "id": "/d/jiaxing/obj/flower_shoe",
      "table": "items"
    },
    {
      "desc": "一位年过花甲的老管家，背略微驼，守在刘庄门内，见人先拱手问安。",
      "id": "/d/hangzhou/npc/guanjia",
      "table": "npcs"
    },
    {
      "desc": "一位风尘仆仆的进香客，手里攥着香烛，神色虔诚。",
      "id": "/d/hangzhou/npc/guest",
      "table": "npcs"
    },
    {
      "desc": "一名短打装束的家丁，腰间系着布带，目光守着庄内动静。",
      "id": "/d/hangzhou/npc/jiading",
      "table": "npcs"
    },
    {
      "desc": "一个游兴正浓的年轻人，东张西望，时不时停下来打量泉边的景致。",
      "id": "/d/hangzhou/npc/you-ke",
      "table": "npcs"
    }
