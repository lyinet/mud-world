.venv/
runs/
backups/
.pytest_cache/
__pycache__/
*.pyc
*.pyo
*.sqlite
*.sqlite-*
# 交付产物不入库（历史已入库的 p3f 产物按 git rm --cached 处理）
dist/
# 本地环境变量与私钥
.env
.env.local
*.pem
*.key
# 反向代理的证书/私钥/Basic 凭据（由 deploy/gen_* 脚本生成，不入库）
deploy/certs/*
# 只保留 ACME HTTP-01 的 webroot 占位目录（其他内容仍忽略）
!deploy/certs/acme/
deploy/certs/acme/*
!deploy/certs/acme/.gitkeep
# 演练/压测产物中的凭证默认不入库（令牌只允许留摘要）
**/token.txt
**/*.token
reports/**/token*
# 凭证/令牌类检查产物（reports 下仍有交付证据，不做整目录忽略）
reports/**/token*.txt
reports/**/*-check.txt
# 本地自动推送日志
.git/push.log
# 滚动重启的 CPU 基线是本机采样值，不入库（生成方式见 deploy/README.md）
deploy/.cpu_baseline
# 报告产物入库口径（2026-11-06 定稿；只约束新增/未入库文件，不改写历史里已有的 png）
# 入库：reports/**/*.json、reports/**/*.md —— 验收证据，体量小、可复核。
# 不入库：截图与运行日志/采样流（png/jpg/jpeg/webp、log/txt/jsonl）以及探针脚手架，
# 都是一次性产物，可由报告 JSON 与脚本重跑复现；仓库只留结构化结论。
# 历史已入库的截图/采样（如 reports/w4-*/**.png、reports/evidence/**/world_hash.txt）
# 作为冻结证据保留、不再随重跑更新；新产出一律按本口径不入库，不要再问是否补交。
reports/**/*.png
reports/**/*.jpg
reports/**/*.jpeg
reports/**/*.webp
reports/**/*.log
reports/**/*.txt
reports/**/*.jsonl
reports/**/_probe/
# 交付证据里的 run 目录需要入库，供干净 clone 直接事件回放。
!reports/evidence/runs/
!reports/evidence/runs/**
.DS_Store
# 容量/压测的运行日志是临时产物（可由报告 JSON 与 docs/CAPACITY.md 第 8 节命令复现），不入库；
# 入库的报告证据只保留 reports/capacity/raw-*.json 与 probe-*.json。
reports/capacity/*.log
