<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.xkx.ref</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DRIVER__</string>
    <string>config.ini</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__MUDLIB__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__LOGDIR__/driver.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGDIR__/driver.err.log</string>
</dict>
</plist>
